    "/api/agent/tools/anomalies/rank": {
      "post": {
        "operationId": "rank_anomaly_candidates",
        "summary": "排序异常候选",
        "description": "对已有候选做Top N排序，不足7笔不凑数。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organization_id": {
                    "type": "string",
                    "description": "组织ID，演示环境填写ORG-DEMO",
                    "default": "ORG-DEMO"
                  },
                  "current_user_id": {
                    "type": "string",
                    "description": "当前FlowOrder用户ID，例如USER-1或MANAGER-1",
                    "example": "USER-1"
                  },
                  "current_role": {
                    "type": "string",
                    "description": "当前角色",
                    "enum": [
                      "operator",
                      "manager"
                    ],
                    "default": "operator"
                  },
                  "allowed_owner_ids": {
                    "type": "array",
                    "description": "可选的额外授权负责人ID",
                    "items": {
                      "type": "string"
                    }
                  },
                  "run_id": {
                    "type": "string",
                    "description": "start_agent_run返回的运行ID"
                  },
                  "top_n": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 7
                  },
                  "items": {
                    "type": "array",
                    "description": "已经生成的异常候选数组",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "required": [
                  "current_user_id",
                  "items"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "请求参数或业务条件错误"
          },
          "401": {
