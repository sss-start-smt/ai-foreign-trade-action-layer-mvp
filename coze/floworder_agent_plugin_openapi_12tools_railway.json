                    "enum": [
                      "operator",
                      "manager"
                    ],
                    "default": "operator"
                  },
                  "allowed_owner_ids": {
                    "type": "array",
                    "description": "可选的额外授权负责人ID",
                    "items": {
                      "type": "string"
                    }
                  },
                  "run_id": {
                    "type": "string",
                    "description": "可选，start_agent_run返回的运行ID"
