    "/api/agent/tools/task-drafts/create": {
      "post": {
        "operationId": "create_task_draft",
        "summary": "生成任务草稿",
        "description": "生成任务草稿；标准巡检可在同一次工具调用中同时创建关联人工审批，仍不会创建正式任务。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organization_id": {
                    "type": "string",
                    "description": "组织ID，演示环境填写ORG-DEMO",
                    "default": "ORG-DEMO"
                  },
                  "current_user_id": {
                    "type": "string",
                    "description": "当前FlowOrder用户ID，例如USER-1或MANAGER-1",
                    "example": "USER-1"
                  },
                  "current_role": {
                    "type": "string",
                    "description": "当前角色",
                    "enum": [
                      "operator",
                      "manager"
                    ],
                    "default": "operator"
                  },
                  "allowed_owner_ids": {
                    "type": "array",
                    "description": "可选的额外授权负责人ID",
                    "items": {
                      "type": "string"
                    }
                  },
                  "run_id": {
                    "type": "string",
                    "description": "start_agent_run返回的运行ID"
                  },
                  "order_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "recommended_action": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string",
                    "enum": [
                      "customer",
                      "factory",
                      "supplier",
                      "internal",
                      "manager"
                    ]
                  },
                  "owner_user_id": {
                    "type": "string"
                  },
                  "risk_level": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  },
                  "business_deadline": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "create_approval_request": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否在同一次调用中为CREATE_TASK创建关联人工审批，减少Agent往返次数"
                  },
                  "approval_idempotency_key": {
                    "type": "string",
                    "description": "可选审批幂等键；未提供时按run_id与order_id生成"
                  }
                },
                "required": [
                  "current_user_id",
                  "order_id",
                  "title"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "请求参数或业务条件错误"
          },
          "401": {
            "description": "插件密钥错误"
          },
          "403": {
            "description": "无权限"
          },
          "404": {
            "description": "资源不存在"
          },
          "429": {
            "description": "达到工具调用或时间预算"
          }
        }
      }
