{
  "openapi": "3.0.0",
  "info": {
    "title": "FlowOrder Agent Tools V6.1",
    "version": "6.1.3",
    "description": "FlowOrder订单异常诊断Agent的12个工具。新增批量自然语言更新解析和Top 7笔不同风险订单组合诊断。插件固定Header配置X-FlowOrder-Agent-Key。 V6.1.3将信息缺口单独返回，并按订单聚合多异常。"
  },
  "servers": [
    {
      "url": "https://ai-foreign-trade-action-system-production-ce23.up.railway.app"
    }
  ],
  "paths": {
    "/api/agent/tools/runs/start": {
      "post": {
        "operationId": "start_agent_run",
        "summary": "开始一次Agent诊断运行",
        "description": "创建运行记录并返回run_id；每次新诊断或巡检首先调用。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organization_id": {
                    "type": "string",
                    "description": "组织ID，演示环境填写ORG-DEMO",
                    "default": "ORG-DEMO"
                  },
                  "current_user_id": {
                    "type": "string",
                    "description": "当前FlowOrder用户ID，例如USER-1或MANAGER-1",
                    "example": "USER-1"
                  },
                  "current_role": {
                    "type": "string",
                    "description": "当前角色",
                    "enum": [
                      "operator",
                      "manager"
                    ],
                    "default": "operator"
                  },
                  "allowed_owner_ids": {
                    "type": "array",
                    "description": "可选的额外授权负责人ID",
                    "items": {
                      "type": "string"
                    }
                  },
                  "goal": {
                    "type": "string",
                    "description": "本次诊断目标",
                    "example": "检查我未来14天最需要处理的订单"
                  },
                  "trigger_type": {
                    "type": "string",
                    "enum": [
                      "USER",
                      "SCHEDULED",
                      "WEBSITE"
                    ],
                    "default": "USER"
                  }
                },
                "required": [
                  "current_user_id",
                  "goal"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "请求参数或业务条件错误"
          },
          "401": {
            "description": "插件密钥错误"
          },
          "403": {
            "description": "无权限"
          },
          "404": {
            "description": "资源不存在"
          },
          "429": {
            "description": "达到工具调用或时间预算"
          }
        }
      }
    },
    "/api/agent/tools/candidate-orders/list": {
      "post": {
        "operationId": "list_candidate_orders",
        "summary": "筛选候选订单",
        "description": "按当前用户权限、未来14天、等待超时和高风险事件筛选候选订单。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organization_id": {
                    "type": "string",
                    "description": "组织ID，演示环境填写ORG-DEMO",
                    "default": "ORG-DEMO"
                  },
                  "current_user_id": {
                    "type": "string",
                    "description": "当前FlowOrder用户ID，例如USER-1或MANAGER-1",
                    "example": "USER-1"
                  },
                  "current_role": {
                    "type": "string",
                    "description": "当前角色",
                    "enum": [
                      "operator",
                      "manager"
                    ],
                    "default": "operator"
                  },
                  "allowed_owner_ids": {
                    "type": "array",
                    "description": "可选的额外授权负责人ID",
                    "items": {
                      "type": "string"
                    }
                  },
                  "run_id": {
                    "type": "string",
                    "description": "start_agent_run返回的运行ID"
                  },
                  "due_within_days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 90,
                    "default": 14
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200,
                    "default": 50
                  },
                  "current_time": {
                    "type": "string",
                    "format": "date-time",
                    "description": "可选，默认北京时间当前时间"
                  }
                },
                "required": [
                  "current_user_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "请求参数或业务条件错误"
          },
          "401": {
            "description": "插件密钥错误"
          },
          "403": {
            "description": "无权限"
          },
          "404": {
            "description": "资源不存在"
          },
          "429": {
            "description": "达到工具调用或时间预算"
          }
        }
      }
    },
