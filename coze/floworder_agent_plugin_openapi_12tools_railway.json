                    "enum": [
                      "operator",
                      "manager"
                    ],
                    "default": "operator"
                  },
                  "allowed_owner_ids": {
                    "type": "array",
                    "description": "可选的额外授权负责人ID",
                    "items": {
                      "type": "string"
                    }
                  },
                  "run_id": {
                    "type": "string",
                    "description": "start_agent_run返回的运行ID"
                  },
                  "order_id": {
                    "type": "string"
                  },
                  "anomaly_types": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "SUPPLIER_COMMITMENT_OVERDUE",
                        "CUSTOMER_CONFIRMATION_BLOCKING",
                        "DELIVERY_RISK",
                        "LOGISTICS_EXCEPTION",
                        "INFORMATION_GAP"
                      ]
                    }
                  },
                  "current_time": {
                    "type": "string",
                    "format": "date-time"
