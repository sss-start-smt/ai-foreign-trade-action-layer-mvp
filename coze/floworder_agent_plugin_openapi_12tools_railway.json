    "/api/agent/tools/anomalies/build": {
      "post": {
        "operationId": "build_anomaly_candidate",
        "summary": "生成异常候选",
        "description": "基于确定性规则生成带证据的异常候选，不代表正式确认。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organization_id": {
                    "type": "string",
                    "description": "组织ID，演示环境填写ORG-DEMO",
                    "default": "ORG-DEMO"
                  },
                  "current_user_id": {
                    "type": "string",
