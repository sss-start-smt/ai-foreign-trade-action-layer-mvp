          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organization_id": {
                    "type": "string",
                    "description": "组织ID，演示环境填写ORG-DEMO",
                    "default": "ORG-DEMO"
                  },
                  "current_user_id": {
